# Backend API Config
API_PORT=3668
NODE_ENV=production

# API URL for frontend
VITE_API_URL=https://smax.ferry.vn/api

# CORS Settings - Cho phép domain của bạn
CORS_ORIGIN=https://smax.ferry.vn

# Domain Settings
DOMAIN=smax.ferry.vn
PROTOCOL=https

# API Keys (nếu cần)
# API_KEY=your-api-key-here

# Database (nếu có)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=smax_erp
# DB_USER=root
# DB_PASS=password

# Session Secret (for production)
SESSION_SECRET=change-this-to-random-string-in-production

# Log Level
LOG_LEVEL=info